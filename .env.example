# ─────────────────────────────────────────────────────────────────────────────
# LAB2 ML – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
FLASK_ENV=production

# ── Model ────────────────────────────────────────────────────────────────────
# Absolute path inside the container where the trained checkpoint is stored.
MODEL_PATH=/app/checkpoints/best_model.pth
# Image size the model was trained on (square).
IMAGE_SIZE=256

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Required to download datasets / gated models from HuggingFace Hub.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Docker Hub ───────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=eliasc2004
DOCKERHUB_REPO=segmentation-api

# ── API Security (optional bearer token) ────────────────────────────────────
# Leave blank to disable authentication.
API_KEY=
